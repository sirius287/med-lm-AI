# Compatibility template; .env.example and SETUP_WINDOWS.md are authoritative.
# Prefer scripts/dev.py init-db; never overwrite an existing populated .env.
MEDLM_ENVIRONMENT=development
MEDLM_DATABASE_URL=
MEDLM_SUPABASE_URL=
MEDLM_SUPABASE_PUBLISHABLE_KEY=
MEDLM_SESSION_ENCRYPTION_KEY=
# Separate Fernet key for manual-mutation response replay. Required for manual POSTs.
MEDLM_MEDICATION_ENCRYPTION_KEY=
# Optional JSON array of previous Fernet keys, newest first (maximum three).
MEDLM_SESSION_DECRYPTION_KEYS=[]
# Independent random secret, >=32 characters; required in production.
MEDLM_AUTH_RATE_LIMIT_KEY=
MEDLM_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
MEDLM_COOKIE_SECURE=false
# No AI credentials are required. Normal uploads and providers stay disabled.
