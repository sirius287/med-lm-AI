# Copy to root .env; never commit the populated file.
MEDLM_ENVIRONMENT=development
MEDLM_DATABASE_URL=
MEDLM_SUPABASE_URL=
MEDLM_SUPABASE_PUBLISHABLE_KEY=
MEDLM_SESSION_ENCRYPTION_KEY=
# Optional JSON array of previous Fernet keys, newest first (maximum three).
MEDLM_SESSION_DECRYPTION_KEYS=[]
# Independent random secret, >=32 characters; required in production.
MEDLM_AUTH_RATE_LIMIT_KEY=
MEDLM_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
MEDLM_COOKIE_SECURE=false
# Reserved for a future authorized phase; not required by the foundation.
MEDLM_OPENAI_API_KEY=
MEDLM_OPENAI_MODEL=gpt-6-astra
