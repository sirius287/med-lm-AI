      "delete": {
        "summary": "Logout",
        "operationId": "logout_api_v1_auth_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/health/database": {
      "get": {
        "summary": "Database Health",
        "operationId": "database_health_api_v1_health_database_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Create",
        "operationId": "create_api_v1_uploads_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyntheticUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadIntent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{upload_id}": {
      "get": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Get",
        "operationId": "get_api_v1_uploads__upload_id__get",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Delete",
        "operationId": "delete_api_v1_uploads__upload_id__delete",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "204": {
            "description": "Already deleted"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{upload_id}/content": {
      "put": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Content",
        "operationId": "content_api_v1_uploads__upload_id__content_put",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          },
          {
            "name": "x-upload-ticket",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "title": "X-Upload-Ticket"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{upload_id}/complete": {
      "post": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Complete",
        "operationId": "complete_api_v1_uploads__upload_id__complete_post",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{upload_id}/preview": {
      "get": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Preview",
        "operationId": "preview_api_v1_uploads__upload_id__preview_get",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{upload_id}/receipts": {
      "get": {
        "tags": [
          "synthetic-uploads"
        ],
        "summary": "Receipts",
        "operationId": "receipts_api_v1_uploads__upload_id__receipts_get",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompletionRequest": {
        "properties": {
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Checksum Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checksum_sha256"
        ],
        "title": "CompletionRequest"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DeletionReceipt": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "format": "uuid",
            "title": "Receipt Id"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "title": "Verified At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "receipt_id",
          "verified_at",
          "expires_at"
        ],
        "title": "DeletionReceipt"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "medlm-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "Health"
      },
      "ReceiptList": {
        "properties": {
          "receipts": {
            "items": {
              "$ref": "#/components/schemas/DeletionReceipt"
            },
            "type": "array",
            "title": "Receipts"
          }
        },
        "type": "object",
        "required": [
          "receipts"
        ],
        "title": "ReceiptList"
      },
      "SyntheticUploadRequest": {
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Content Type"
          },
          "byte_size": {
            "type": "integer",
            "maximum": 10485760.0,
            "exclusiveMinimum": 0.0,
            "title": "Byte Size"
          },
          "document_kind": {
            "type": "string",
            "pattern": "^(strip|bottle|tube|box|prescription)$",
            "title": "Document Kind"
          },
          "retain_for_review": {
            "type": "boolean",
            "title": "Retain For Review",
            "default": false
          },
          "consent_version": {
            "type": "string",
            "const": "synthetic-v1",
            "title": "Consent Version"
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Checksum Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content_type",
          "byte_size",
          "document_kind",
          "consent_version",
          "checksum_sha256"
        ],
        "title": "SyntheticUploadRequest"
      },
      "UploadIntent": {
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "title": "Upload Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "initiated",
              "accepted",
              "rejected",
              "deleting",
              "deleted"
            ],
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "purge_at": {
            "type": "string",
            "format": "date-time",
            "title": "Purge At"
          },
          "upload_url": {
            "type": "string",
            "title": "Upload Url"
          },
          "ticket": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticket"
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Upload Expires At"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "status",
          "version",
          "purge_at",
          "upload_url",
          "ticket",
          "upload_expires_at"
        ],
        "title": "UploadIntent"
      },
      "UploadState": {
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "title": "Upload Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "initiated",
              "accepted",
              "rejected",
              "deleting",
              "deleted"
            ],
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "purge_at": {
            "type": "string",
            "format": "date-time",
            "title": "Purge At"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "status",
          "version",
          "purge_at"
        ],
        "title": "UploadState"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
